#!/usr/bin/env python3
"""Globo em wireframe girando, ocupando o terminal inteiro.

Port do "wireframe-globe" de ascii-magic-art (Kailash, MIT):
https://github.com/kailashsr38/ascii-magic-art/blob/main/pieces/wireframe-globe.js
Projeção ortográfica, eixo inclinado 23,5°, z-buffer, caractere pela direção da linha.

Uso: wireframe-globe                      desenha no terminal (screensaver do kitty)
     wireframe-globe --pango ARQ --cols C --rows R --aspect A [--fps F]
                                         escreve cada quadro em ARQ como Pango markup
                                         (lido por um label do hyprlock com a tela bloqueada)
"""
import argparse, fcntl, html, math, os, signal, struct, sys, termios, time

FPS = 30
SPIN = 0.3            # rad/s em torno do eixo (~21s por volta; o original usa 0.6)
SIZE = 0.62           # diâmetro do globo como fração da altura da tela
TILT = 0.41           # ~23,5°
LIGHT = (-0.72, 0.55, -0.42)

def hex2rgb(h): return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))

def gradient(stops, n):
    stops = [hex2rgb(s) for s in stops]
    out = []
    for i in range(n):
        t = i / (n - 1) * (len(stops) - 1)
        k = min(int(t), len(stops) - 2); f = t - k
        out.append(tuple(round(a + (b - a) * f) for a, b in zip(stops[k], stops[k + 1])))
    return out

FRONT = gradient(["#1f6f5a", "#3fbf8f", "#9ff5cf", "#eafff5"], 8)
BACK, SHELL, SHELL_DARK, EQUATOR = (hex2rgb(h) for h in ("#173a4a", "#0e2230", "#0a1820", "#ffd166"))

def sgr(rgb): return "\x1b[38;2;%d;%d;%dm" % rgb

def slope_char(dx, dy, aspect):  # dx, dy em células; dy cresce para baixo
    a = math.atan2(dy * aspect, dx)          # ângulo real na tela (original: dy * 2)
    if abs(math.sin(a)) < 0.38: return "─"
    if abs(math.cos(a)) < 0.38: return "│"
    return "╲" if (dx > 0) == (dy > 0) else "╱"

def build_wires(rc):
    """Pontos (x, y, z, tx, ty, tz, tipo) na esfera unitária; densidade acompanha o raio."""
    n = max(260, int(2 * math.pi * rc * 1.6))
    pts = []
    for k in range(6):                                   # meridianos (círculos máximos a cada 30°)
        lon = math.radians(30 * k); cl, sl = math.cos(lon), math.sin(lon)
        for i in range(n):
            th = 2 * math.pi * i / n; c, s = math.cos(th), math.sin(th)
            pts.append((c * cl, s, c * sl, -s * cl, c, -s * sl, 0))
    for lat in (-60, -30, 0, 30, 60):                    # paralelos; 0 = equador
        ph = math.radians(lat); cp, sp = math.cos(ph), math.sin(ph)
        m = int(math.ceil(n * cp)) + 20
        for i in range(m):
            la = 2 * math.pi * i / m; c, s = math.cos(la), math.sin(la)
            pts.append((cp * c, sp, cp * s, -s, 0.0, c, 2 if lat == 0 else 1))
    return pts

def build_shell(cols, rows, cx, cy, rr, rc):
    """Casca estática (a luz é fixa na tela), atrás de tudo: '░' onde está iluminada."""
    L = math.sqrt(sum(v * v for v in LIGHT)); lx, ly, lz = (v / L for v in LIGHT)
    shell = {}
    for sy in range(rows):
        for sx in range(cols):
            x, y = (sx + 0.5 - cx) / rc, -(sy + 0.5 - cy) / rr
            d = x * x + y * y
            if d >= 1: continue
            l = max(0.0, x * lx + y * ly - math.sqrt(1 - d) * lz) * 0.78
            shell[(sx, sy)] = ("░" if l > 0.45 else " ", SHELL if l > 0.6 else SHELL_DARK)
    return shell

def cell_aspect():
    """Altura/largura de uma célula em pixels (o kitty informa via TIOCGWINSZ)."""
    try:
        rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
        if xpx and ypx and rows and cols:
            return (ypx / rows) / (xpx / cols)
    except OSError:
        pass
    return 2.0

class Globe:
    def __init__(self, cols, rows, aspect):
        self.cols, self.rows, self.aspect = cols, rows, aspect
        rr = rows * SIZE / 2; rc = rr * aspect                # rc/rr = aspect -> redondo de verdade
        if rc > cols * 0.45: rc = cols * 0.45; rr = rc / aspect
        self.rr, self.rc, self.cx, self.cy = rr, rc, cols / 2, rows / 2
        self.wires = build_wires(rc)
        self.shell = build_shell(cols, rows, self.cx, self.cy, rr, rc)

    def frame(self, t):
        """Linhas de [(char, rgb|None)] para o instante t (s)."""
        cols, rows, rr, rc, cx, cy = self.cols, self.rows, self.rr, self.rc, self.cx, self.cy
        ct, st = math.cos(TILT), math.sin(TILT)
        a = t * SPIN; ca, sa = math.cos(a), math.sin(a)
        zbuf = {}
        for (wx, wy, wz, tx, ty, tz, kind) in self.wires:
            x0 = wx * ca + wz * sa; z = -wx * sa + wz * ca      # gira no eixo
            x = x0 * ct - wy * st; y = x0 * st + wy * ct        # inclina o eixo
            sx = math.floor(cx + x * rc); sy = math.floor(cy - y * rr)
            if not (0 <= sx < cols and 0 <= sy < rows): continue
            if z < 0:
                tx0 = tx * ca + tz * sa
                dx = (tx0 * ct - ty * st) * rc; dy = -(tx0 * st + ty * ct) * rr
                color = EQUATOR if kind == 2 else FRONT[min(7, int((-z * 0.75 + 0.25) * 8))]
                cell = (2 - z, slope_char(dx, dy, self.aspect), color)
            else:
                cell = (1 - z, "·", BACK)                 # lado de trás: pontinhos apagados
            old = zbuf.get((sx, sy))
            if old is None or cell[0] > old[0]: zbuf[(sx, sy)] = cell
        out = []
        for sy in range(rows):
            row = []
            for sx in range(cols):
                c = zbuf.get((sx, sy))
                if c: row.append((c[1], c[2]))
                elif (sx, sy) in self.shell: row.append(self.shell[(sx, sy)])
                else: row.append((" ", None))
            out.append(row)
        return out

def to_ansi(lines):
    out, last = [], None
    for row in lines:
        parts = []
        for ch, col in row:
            if col is not None and col != last: parts.append(sgr(col)); last = col
            parts.append(ch)
        out.append("".join(parts))
    return "\x1b[H" + "\n".join(out)

def to_pango(lines):
    """Tudo sobre fundo preto (cobre a tela de bloqueio); um <span> por troca de cor."""
    out = ['<span background="#000000" foreground="#000000">']
    for row in lines:
        last, run = None, []
        def flush():
            if run:
                txt = html.escape("".join(run), quote=False)
                out.append(txt if last is None else '<span foreground="#%02x%02x%02x">%s</span>' % (*last, txt))
        for ch, col in row:
            col = None if ch == " " else col
            if col != last: flush(); last, run = col, []
            run.append(ch)
        flush(); out.append("\n")
    out[-1] = "</span>"
    return "".join(out)

def run_terminal():
    out = sys.stdout
    def bye(*_):
        out.write("\x1b[0m\x1b[?25h"); out.flush(); sys.exit(0)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP): signal.signal(sig, bye)
    out.write("\x1b[?25l\x1b[2J")
    size, globe, t0 = None, None, time.monotonic()
    while True:
        frame_start = time.monotonic()
        cur = os.get_terminal_size()
        if cur != size:                                   # (re)calcula tudo que depende do tamanho
            size = cur; globe = Globe(cur.columns, cur.lines, cell_aspect())
            out.write("\x1b[2J")
        out.write(to_ansi(globe.frame(frame_start - t0))); out.flush()
        time.sleep(max(0, 1 / FPS - (time.monotonic() - frame_start)))

def run_pango(path, cols, rows, aspect, fps):
    def bye(*_):
        try: os.unlink(path)
        except OSError: pass
        sys.exit(0)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP): signal.signal(sig, bye)
    globe, t0, tmp = Globe(cols, rows, aspect), time.monotonic(), path + ".tmp"
    while True:
        frame_start = time.monotonic()
        with open(tmp, "w") as f: f.write(to_pango(globe.frame(frame_start - t0)))
        os.replace(tmp, path)                             # troca atômica: o hyprlock nunca lê meio quadro
        time.sleep(max(0, 1 / fps - (time.monotonic() - frame_start)))

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--pango"); ap.add_argument("--cols", type=int, default=120)
    ap.add_argument("--rows", type=int, default=40); ap.add_argument("--aspect", type=float, default=2.4)
    ap.add_argument("--fps", type=float, default=10)
    a = ap.parse_args()
    if a.pango: run_pango(a.pango, a.cols, a.rows, a.aspect, a.fps)
    else: run_terminal()

if __name__ == "__main__":
    main()
