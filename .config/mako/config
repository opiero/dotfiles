# Visual alinhado com o Hyprland (borda ativa #33ccff, rounding 10) e a Waybar.
# Ordem importa: seções que vêm depois sobrescrevem as de cima.

font=JetBrainsMono Nerd Font 11
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#33ccffee
border-size=2
border-radius=10
progress-color=over #33ccff99

anchor=top-right
margin=12
outer-margin=6,6,0,0
padding=12,14
width=380
max-visible=5
max-icon-size=48
icons=1
markup=1
format=<b>%s</b>\n%b
default-timeout=6000

[urgency=low]
border-color=#595959aa
text-color=#a6adc8

[urgency=critical]
border-color=#f38ba8ee
default-timeout=0

[mode=do-not-disturb]
invisible=1

# OSD de volume (scripts/volume.sh do hypr)
[app-name=osd]
anchor=bottom-center
outer-margin=0,0,80,0
width=320
padding=10,14
text-alignment=center
format=<b>%s</b>
default-timeout=1500
history=0
