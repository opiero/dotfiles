{
  "layer": "top",
  "position": "top",
  "height": 32,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/date", "clock"],
  "modules-right": ["pulseaudio", "network", "battery", "cpu", "memory", "tray"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false
  },

  "custom/date": {
    "exec": "LC_TIME=pt_BR.UTF-8 date '+%a, %d/%m' | sed 's/^./\\U&/'",
    "interval": 60,
    "format": "󰃭  {}",
    "tooltip": false
  },

  "clock": {
    "locale": "pt_BR.UTF-8",
    "format": "{:%H:%M}",
    "tooltip-format": "{:L%A, %d de %B de %Y}"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  mudo",
    "format-bluetooth": "󰂰  {volume}%",
    "format-bluetooth-muted": "󰂰  mudo",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc}\n{volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/hypr/scripts/volume.sh mute",
    "on-scroll-up": "~/.config/hypr/scripts/volume.sh up",
    "on-scroll-down": "~/.config/hypr/scripts/volume.sh down"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀  Connected",
    "format-disconnected": "  Offline"
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "{icon}  {capacity}%",
    "format-plugged": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "charging": [
        "󰢟",
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "plugged": [
        "󰚥"
      ],
      "full": [
        "󰚥"
      ]
    },
    "tooltip-format": "{timeTo}\n{power:.1f} W"
  },

  "cpu": {
    "format": "  {usage}%"
  },

  "memory": {
    "format": "󰍛  {used:0.1f}G",
    "tooltip-format": "{used:0.1f} de {total:0.1f} GiB usados ({percentage}%)"
  },

  "tray": {
    "spacing": 10
  }
}
